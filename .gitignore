# ============================================================
# STM32CubeMX + Keil MDK5 .gitignore
# ============================================================

# ---------- Keil MDK 编译输出目录 ----------
**/MDK-ARM/Objects/
**/MDK-ARM/Listings/
**/MDK-ARM/DebugConfig/

# ---------- Keil MDK 编译中间文件与固件 ----------
**/*.o
**/*.obj
**/*.d
**/*.crf
**/*.dep
**/*.lnp
**/*.map
**/*.lst
**/*.axf
**/*.elf
**/*.hex
**/*.bin
**/*.htm
**/*.build_log.htm
**/*.iex
**/*.__i

# ---------- Keil MDK 自动备份 ----------
**/*.bak
**/*.uvopt.bak
**/*.uvproj.bak
**/*.uvprojx.bak

# ---------- Keil MDK 个人界面/调试器本地状态 ----------
**/*.uvoptx
**/*.uvopt
**/*.uvguix.*
**/JLinkLog.txt
**/JLinkSettings.ini
**/*.log
**/*.scvd

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 编辑器本地目录 ----------
.vscode/
.idea/
*.swp
*~

# ---------- 临时文件 ----------
*.tmp
*.temp